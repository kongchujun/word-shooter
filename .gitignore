# 密钥和后台密码,绝对不能进仓库
.env
.env.local

node_modules/
build/
dist/
web/dist/*
!web/dist/.gitkeep

# deploy.sh 在服务器上留下的东西。
# 必须带开头的斜杠锚到仓库根:不带斜杠的 `word-shooter` 会匹配**任意层级**的
# 同名文件和目录,把源码目录 cmd/word-shooter/ 一起吞掉 —— 踩过这个坑,
# 症状是本地能编译,CI 检出后报 cmd/word-shooter: directory not found。
/word-shooter
/word-shooter.pid
/word-shooter.log

# 素材是你自己的图和音频,不进仓库
assets/images/*
assets/audio/*
assets/sfx/*
!assets/**/.gitkeep
# 后台写的生成参数,跟着素材走
assets/settings.json

# 编辑器
.idea/
.claude/
.DS_Store

# 访问日志(含 IP,绝对不能进仓库)。data/ 是现在的 SQLite,logs/ 是早期的 JSONL
data/
logs/

# IP 归属地库,构建时下载,不进仓库(11MB)
internal/geoip/data/*.xdb
