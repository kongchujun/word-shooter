# 密钥和后台密码,绝对不能进仓库
.env
.env.local

node_modules/
build/
dist/
web/dist/*
!web/dist/.gitkeep

# deploy.sh 在服务器上留下的东西
word-shooter
word-shooter.pid
word-shooter.log

# 素材是你自己的图和音频,不进仓库
assets/images/*
assets/audio/*
assets/sfx/*
!assets/**/.gitkeep
# 后台写的生成参数,跟着素材走
assets/settings.json

# 编辑器
.idea/
.claude/
.DS_Store

# 访问日志(含 IP,不进仓库)
logs/

# IP 归属地库,构建时下载,不进仓库(11MB)
geoip/*.xdb
