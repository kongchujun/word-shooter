# 复制成 .env 再填。.env 已经在 .gitignore 里,不会被提交。
# 放在二进制同目录即可(开发时放项目根目录也能读到)。

# 后台管理页的账号密码。少一个的话整个 /admin 会被禁用。
admin=
password=

# AI 生成图片和发音要用。不填也能进后台管词条,只是没有生成按钮。
OPENROUTER_API_KEY=

# 可选:不想进后台改设置的话,在这里直接指定模型。
# OPENROUTER_IMAGE_MODEL=sourceful/riverflow-v2.5-fast
# OPENROUTER_IMAGE_SIZE=1024x1024
# OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
# OPENROUTER_TTS_VOICE=af_bella

# 发音的第二个来源(可选)。端点按区域走,区域不对一律 401。
AZURE_API_KEY=
AZURE_SPEECH_REGION=eastasia
AZURE_TTS_VOICE=en-US-AnaNeural
# 默认走哪个语音源:azure | openrouter
TTS_PROVIDER=azure
